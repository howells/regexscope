{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**"
      ],
      "cache": false
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "cache": false
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  },
  "globalDependencies": [
    "**/.env",
    "**/.env.local"
  ]
}
